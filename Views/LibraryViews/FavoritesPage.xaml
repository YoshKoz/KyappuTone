<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="KyappuTone.Views.LibraryViews.FavoritesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Loaded="Page_Loaded"
      mc:Ignorable="d">

	<Grid Margin="20,10,20,10"
	      RowSpacing="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Grid>
			<TextBlock Style="{ThemeResource TitleTextBlockStyle}"
			           Text="Favorites"
			           ToolTipService.ToolTip="Songs you marked as favorites" />
			<StackPanel HorizontalAlignment="Right"
			            Orientation="Horizontal"
			            Spacing="8">
				<Button Click="PlayAll_Click"
				        ToolTipService.ToolTip="Play all favorites">
					<StackPanel Orientation="Horizontal"
					            Spacing="6">
						<FontIcon Glyph="&#xF5B0;" />
						<TextBlock Text="Play all" />
					</StackPanel>
				</Button>
				<Button Click="ShuffleAndPlay_Click"
				        ToolTipService.ToolTip="Shuffle all favorites">
					<StackPanel Orientation="Horizontal"
					            Spacing="6">
						<FontIcon Glyph="&#xE8B1;" />
						<TextBlock Text="Shuffle" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>

		<ListView x:Name="SongListView"
		          Grid.Row="1"
		          Background="Transparent"
		          IsItemClickEnabled="True"
		          ItemClick="SongListView_ItemClick"
		          SelectionMode="Single">
			<ListView.ItemTemplate>
				<DataTemplate>
					<Grid Padding="4"
					      ColumnSpacing="10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="36" />
							<ColumnDefinition Width="2*" />
							<ColumnDefinition Width="1.4*" />
							<ColumnDefinition Width="1.2*" />
						</Grid.ColumnDefinitions>
						<Button Width="32"
						        Height="32"
						        Padding="0"
						        Background="Transparent"
						        Click="RemoveFavorite_Click"
						        Tag="{Binding Path}"
						        ToolTipService.ToolTip="Remove from favorites">
							<FontIcon FontSize="16"
							          Glyph="&#xE735;" />
						</Button>
						<TextBlock Grid.Column="1"
						           VerticalAlignment="Center"
						           Text="{Binding Title}"
						           TextTrimming="CharacterEllipsis" />
						<TextBlock Grid.Column="2"
						           VerticalAlignment="Center"
						           Opacity="0.8"
						           Text="{Binding Artists}"
						           TextTrimming="CharacterEllipsis" />
						<TextBlock Grid.Column="3"
						           VerticalAlignment="Center"
						           Opacity="0.7"
						           Text="{Binding Album}"
						           TextTrimming="CharacterEllipsis" />
					</Grid>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>

		<TextBlock x:Name="EmptyText"
		           Grid.Row="1"
		           HorizontalAlignment="Center"
		           VerticalAlignment="Center"
		           Opacity="0.7"
		           Text="No favorites yet. Use the heart button on the player or in All Songs."
		           TextWrapping="Wrap"
		           Visibility="Collapsed" />
	</Grid>
</Page>
