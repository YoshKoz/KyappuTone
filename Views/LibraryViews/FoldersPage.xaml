<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="KyappuTone.Views.LibraryViews.FoldersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
	<Grid Margin="24,20,24,20"
	      RowSpacing="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Grid Grid.Row="0"
		      ColumnSpacing="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<StackPanel Spacing="4">
				<TextBlock Style="{ThemeResource TitleTextBlockStyle}"
				           Text="Folders" />
				<TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				           Text="Auto-managed playlists for the first-level folders in your libraries." />
			</StackPanel>
			<Button x:Name="RefreshButton"
			        Grid.Column="1"
			        Click="RefreshButton_Click"
			        Content="Refresh" />
		</Grid>

		<Grid Grid.Row="1">
			<ListView x:Name="FoldersList"
			          IsItemClickEnabled="True"
			          ItemClick="FoldersList_ItemClick"
			          SelectionMode="None">
				<ListView.ItemTemplate>
					<DataTemplate>
						<Grid MinWidth="520"
						      Padding="12,10"
						      ColumnSpacing="16">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<FontIcon Grid.Column="0"
							          FontSize="22"
							          Glyph="&#xE8B7;" />
							<StackPanel Grid.Column="1"
							            Spacing="2">
								<TextBlock FontWeight="SemiBold"
								           Text="{Binding Name}"
								           TextTrimming="CharacterEllipsis" />
								<TextBlock FontSize="12"
								           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								           Text="{Binding FolderPath}"
								           TextTrimming="CharacterEllipsis" />
							</StackPanel>
							<TextBlock Grid.Column="2"
							           VerticalAlignment="Center"
							           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							           Text="{Binding CountLabel}" />
						</Grid>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
			<StackPanel x:Name="EmptyState"
			            HorizontalAlignment="Center"
			            VerticalAlignment="Center"
			            Spacing="8"
			            Visibility="Collapsed">
				<FontIcon FontSize="40"
				          Glyph="&#xE8B7;" />
				<TextBlock x:Name="EmptyStateTitle"
				           HorizontalAlignment="Center"
				           Style="{ThemeResource SubtitleTextBlockStyle}"
				           Text="No folder playlists yet" />
				<TextBlock x:Name="EmptyStateMessage"
				           HorizontalAlignment="Center"
				           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				           Text="Add a library folder, then run a scan." />
			</StackPanel>
		</Grid>
	</Grid>
</Page>
