<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="KyappuTone.Views.DiscoverPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
	<Page.Resources>
		<DataTemplate x:Key="RadioStationTemplate">
			<Grid MinWidth="720"
			      Padding="10,8"
			      ColumnSpacing="12">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel Grid.Column="0"
				            Spacing="2">
					<TextBlock FontWeight="SemiBold"
					           Text="{Binding Name}"
					           TextTrimming="CharacterEllipsis" />
					<TextBlock FontSize="12"
					           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					           Text="{Binding Tags}"
					           TextTrimming="CharacterEllipsis" />
					<TextBlock FontSize="12"
					           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					           Text="{Binding Country}" />
				</StackPanel>
				<TextBlock Grid.Column="1"
				           VerticalAlignment="Center"
				           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				           Text="{Binding Bitrate}" />
				<Button Grid.Column="2"
				        Click="RadioFavorite_Click"
				        Content="Favorite"
				        Tag="{Binding}" />
				<Button Grid.Column="3"
				        Click="RadioPlay_Click"
				        Content="Play"
				        Tag="{Binding}" />
			</Grid>
		</DataTemplate>
	</Page.Resources>
	<Grid Margin="24,20,24,20"
	      RowSpacing="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Grid Grid.Row="0"
		      ColumnSpacing="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<StackPanel Spacing="4">
				<TextBlock Style="{ThemeResource TitleTextBlockStyle}"
				           Text="Discover" />
				<TextBlock x:Name="ToolStatusText"
				           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				           Text="Checking download tools..." />
			</StackPanel>
			<Button Grid.Column="1"
			        Click="OpenSettings_Click"
			        Content="Download settings" />
		</Grid>

		<TabView x:Name="DiscoverTabs"
		         Grid.Row="1"
		         IsAddTabButtonVisible="False"
		         TabWidthMode="SizeToContent">
			<TabViewItem Header="YouTube"
			             IsClosable="False">
				<Grid Margin="0,12,0,0"
				      RowSpacing="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<StackPanel Grid.Row="0"
					            Orientation="Horizontal"
					            Spacing="8">
						<TextBox x:Name="YouTubeQueryBox"
						         Width="420"
						         KeyDown="YouTubeQueryBox_KeyDown"
						         PlaceholderText="Search YouTube" />
						<Button x:Name="YouTubeSearchButton"
						        Click="YouTubeSearch_Click"
						        Content="Search" />
						<ProgressRing x:Name="YouTubeSearchProgress"
						              Width="20"
						              Height="20"
						              IsActive="False" />
					</StackPanel>
					<ListView x:Name="YouTubeResultsList"
					          Grid.Row="1"
					          SelectionMode="None">
						<ListView.ItemTemplate>
							<DataTemplate>
								<Grid MinWidth="680"
								      Padding="10,8"
								      ColumnSpacing="12">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0"
									            Spacing="2">
										<TextBlock FontWeight="SemiBold"
										           Text="{Binding Title}"
										           TextTrimming="CharacterEllipsis" />
										<TextBlock FontSize="12"
										           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										           Text="{Binding Uploader}"
										           TextTrimming="CharacterEllipsis" />
									</StackPanel>
									<TextBlock Grid.Column="1"
									           VerticalAlignment="Center"
									           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									           Text="{Binding DurationText}" />
									<Button Grid.Column="2"
									        Click="DownloadResult_Click"
									        Content="Download"
									        Tag="{Binding}" />
								</Grid>
							</DataTemplate>
						</ListView.ItemTemplate>
					</ListView>
				</Grid>
			</TabViewItem>

			<TabViewItem Header="Downloads"
			             IsClosable="False">
				<Grid Margin="0,12,0,0"
				      RowSpacing="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<StackPanel Grid.Row="0"
					            Orientation="Horizontal"
					            Spacing="8">
						<Button Click="OpenDownloadsFolder_Click"
						        Content="Open downloads folder" />
						<Button Click="RefreshDownloads_Click"
						        Content="Refresh" />
						<TextBlock x:Name="DownloadsSummaryText"
						           VerticalAlignment="Center"
						           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						           Text="" />
					</StackPanel>
					<ListView x:Name="DownloadsList"
					          Grid.Row="1"
					          SelectionMode="None">
						<ListView.ItemTemplate>
							<DataTemplate>
								<Grid MinWidth="760"
								      Padding="10,8"
								      ColumnSpacing="12">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="140" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0"
									            Spacing="2">
										<TextBlock FontWeight="SemiBold"
										           Text="{Binding Title}"
										           TextTrimming="CharacterEllipsis" />
										<TextBlock FontSize="12"
										           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										           Text="{Binding StatusText}" />
										<TextBlock FontSize="12"
										           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
										           Text="{Binding Error}"
										           TextTrimming="CharacterEllipsis" />
									</StackPanel>
									<ProgressBar Grid.Column="1"
									             VerticalAlignment="Center"
									             Maximum="100"
									             Value="{Binding Progress}" />
									<StackPanel Grid.Column="2"
									            Orientation="Horizontal"
									            Spacing="4">
										<Button Click="RetryDownload_Click"
										        Content="Retry"
										        IsEnabled="{Binding CanRetry}"
										        Tag="{Binding}" />
										<Button Click="CancelDownload_Click"
										        Content="Cancel"
										        IsEnabled="{Binding CanCancel}"
										        Tag="{Binding}" />
										<Button Click="OpenDownloadFolder_Click"
										        Content="Open"
										        IsEnabled="{Binding CanOpen}"
										        Tag="{Binding}" />
									</StackPanel>
								</Grid>
							</DataTemplate>
						</ListView.ItemTemplate>
					</ListView>
					<StackPanel x:Name="DownloadsEmptyState"
					            Grid.Row="1"
					            HorizontalAlignment="Center"
					            VerticalAlignment="Center"
					            Spacing="8">
						<FontIcon FontSize="40"
						          Glyph="&#xE896;" />
						<TextBlock HorizontalAlignment="Center"
						           Style="{ThemeResource SubtitleTextBlockStyle}"
						           Text="No downloads yet" />
						<TextBlock HorizontalAlignment="Center"
						           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						           Text="Search YouTube and send a result here." />
					</StackPanel>
				</Grid>
			</TabViewItem>

			<TabViewItem Header="Radio"
			             IsClosable="False">
				<Grid x:Name="RadioTabHost"
				      Margin="0,12,0,0"
				      RowSpacing="10">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<StackPanel Grid.Row="0"
					            Orientation="Horizontal"
					            Spacing="8">
						<TextBox x:Name="RadioQueryBox"
						         Width="380"
						         KeyDown="RadioQueryBox_KeyDown"
						         PlaceholderText="Search radio stations" />
						<Button x:Name="RadioSearchButton"
						        Click="RadioSearch_Click"
						        Content="Search" />
						<ProgressRing x:Name="RadioSearchProgress"
						              Width="20"
						              Height="20"
						              IsActive="False" />
						<Button Click="StopRadio_Click"
						        Content="Stop" />
					</StackPanel>

					<TextBlock x:Name="RadioNowPlayingText"
					           Grid.Row="1"
					           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					           Text="No station playing." />

					<StackPanel Grid.Row="2"
					            Spacing="4">
						<TextBlock FontWeight="SemiBold"
						           Text="Favorites" />
						<ListView x:Name="RadioFavoritesList"
						          MaxHeight="170"
						          ItemTemplate="{StaticResource RadioStationTemplate}"
						          SelectionMode="None" />
					</StackPanel>

					<Grid Grid.Row="3"
					      RowSpacing="6">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<TextBlock FontWeight="SemiBold"
						           Text="Search results" />
						<ListView x:Name="RadioResultsList"
						          Grid.Row="1"
						          ItemTemplate="{StaticResource RadioStationTemplate}"
						          SelectionMode="None" />
					</Grid>
				</Grid>
			</TabViewItem>
		</TabView>
	</Grid>
</Page>
